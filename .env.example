# Copy to .env.local and fill in. .env.local is never committed.
# Nothing here is a secret: the Supabase URL and publishable key are public by design.
# The Supabase service role key (or any "secret" key) must never appear in this project.

# Where fursa-api runs (browser calls go here; also added to the CSP connect-src)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project (read by server code only, in src/lib/auth)
#   SUPABASE_URL: dashboard > Project Settings > API > Project URL
#   SUPABASE_PUBLISHABLE_KEY: dashboard > Project Settings > API Keys > Publishable key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public URL of this site (used in the links of confirmation and reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production only: the cookie domain shared by this site and the API, so the API receives the
# session. Example: .fursa.app (frontend on fursa.app, API on api.fursa.app). Leave unset locally.
# AUTH_COOKIE_DOMAIN=.fursa.app

# Optional: an address for questions, shown at the end of the Privacy and Terms pages.
# Leave it unset and no contact line is shown. Set it before launch.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@fursa.app
