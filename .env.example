# Copy to .env.local and fill in. .env.local is never committed.
# Nothing here is a secret: the Supabase URL and publishable key are public by design.
# The Supabase service role key must never appear in this project.

# Where fursa-api runs (browser calls go here; also added to the CSP connect-src)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project (used server-side only, from the auth step onwards)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public URL of this site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
